---
import TypographyShell from "$layouts/TypographyShell.astro";
import { getBlogPosts, getPostTags } from "$lib/posts";

const counts = new Map<string, number>();
for (const post of await getBlogPosts()) {
  for (const tag of getPostTags(post)) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
---

<TypographyShell title="标签 | Lights and Shadows" active="tags">
  <h1 class="page-title">标签</h1>
  <ul class="taxonomy-list">
    {[...counts.entries()].sort(([a], [b]) => a.localeCompare(b, "zh-CN")).map(([tag, count]) => (
      <li>{tag}<span class="count">({count})</span></li>
    ))}
  </ul>
</TypographyShell>
