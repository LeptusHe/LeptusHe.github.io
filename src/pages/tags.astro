---
import TypographyShell from "$layouts/TypographyShell.astro";
import TypographyTaxonomyIndex from "$components/TypographyTaxonomyIndex.astro";
import { getBlogPosts, getPostTags } from "$lib/posts";

const groupedPosts = new Map<string, Awaited<ReturnType<typeof getBlogPosts>>>();
for (const post of (await getBlogPosts()).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())) {
  for (const tag of getPostTags(post)) {
    groupedPosts.set(tag, [...(groupedPosts.get(tag) ?? []), post]);
  }
}
const groups = [...groupedPosts.entries()].sort(([a], [b]) => a.localeCompare(b, "zh-CN"));
---

<TypographyShell title="标签 | Lights and Shadows" active="tags">
  <h1 class="page-title">标签</h1>
  <TypographyTaxonomyIndex {groups} variant="tags" />
</TypographyShell>
