---
import TypographyShell from "$layouts/TypographyShell.astro";
import { getBlogPosts, getCategories } from "$lib/posts";

const counts = new Map<string, number>();
for (const post of await getBlogPosts()) {
  for (const category of getCategories(post)) counts.set(category, (counts.get(category) ?? 0) + 1);
}
---

<TypographyShell title="分类 | Lights and Shadows" active="categories">
  <h1 class="page-title">分类</h1>
  <ul class="taxonomy-list">
    {[...counts.entries()].sort(([a], [b]) => a.localeCompare(b, "zh-CN")).map(([category, count]) => (
      <li id={category}>{category}<span class="count">({count})</span></li>
    ))}
  </ul>
</TypographyShell>
