---
import TypographyShell from "$layouts/TypographyShell.astro";
import { getCategories, getPostTags } from "$lib/posts";
import { kUrlBase } from "$consts";

interface Props {
  id: string | false;
  title: string;
  description?: string;
  date: Date;
  tags?: string[];
}

const { id, title, description, date, tags = [] } = Astro.props;
const categories = getCategories({ data: { tags } } as never);
const postTags = getPostTags({ data: { tags } } as never);
---

<TypographyShell title={`${title} | Lights and Shadows`} description={description}>
  <article class="post-container-detail">
    <header>
      <h1 class="post-title">{title}</h1>
      {id && (
        <p class="post-meta">
          <span class="date meta-item">发布于&nbsp;<time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time></span>
          {categories.length > 0 && (
            <span class="meta-item">
              <span class="meta-icon meta-category" aria-hidden="true"></span>&nbsp;
              {categories.map((category) => <><a class="a-tag" href={`${kUrlBase}/categories/#${encodeURIComponent(category)}`}>{category}</a>&nbsp;</>)}
            </span>
          )}
          {postTags.length > 0 && (
            <span class="meta-item">
              <span class="meta-icon meta-tag" aria-hidden="true"></span>&nbsp;
              {postTags.map((tag) => <><a class="a-tag" href={`${kUrlBase}/tags/#${encodeURIComponent(tag)}`}>{tag}</a>&nbsp;</>)}
            </span>
          )}
        </p>
      )}
    </header>
    <div class="post-content"><slot /></div>
  </article>
</TypographyShell>
