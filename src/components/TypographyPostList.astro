---
import type { BlogPost } from "$lib/posts";
import { getCategories, getPostTags, getLegacyPostPath } from "$lib/posts";
import { kUrlBase } from "$consts";

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

<section class="post-list" aria-label="文章列表">
  {
    posts.map((post) => (
      <article class="post-container">
        <h2 class="post-title">
          <a class="a-title" href={`${kUrlBase}${getLegacyPostPath(post)}`}>{post.data.title}</a>
        </h2>
        <p class="post-meta">
          <span class="date meta-item">发布于&nbsp;<time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time></span>
          {getCategories(post).length > 0 && (
            <span class="meta-item">
              <span class="meta-icon meta-category" aria-hidden="true"></span>&nbsp;
              {getCategories(post).map((category) => <><a class="a-tag" href={`${kUrlBase}/categories/#${encodeURIComponent(category)}`}>{category}</a>&nbsp;</>)}
            </span>
          )}
          {getPostTags(post).length > 0 && (
            <span class="meta-item">
              <span class="meta-icon meta-tag" aria-hidden="true"></span>&nbsp;
              {getPostTags(post).map((tag) => <><a class="a-tag" href={`${kUrlBase}/tags/#${encodeURIComponent(tag)}`}>{tag}</a>&nbsp;</>)}
            </span>
          )}
        </p>
        {post.data.description && <div class="post-abstract">{post.data.description}</div>}
      </article>
    ))
  }
</section>
